#!/usr/bin/env python

# mkindex — writes index.html, the repo as a book: index.html.in with its
# library filled from the .md files. rerun after they change, commit both.
#
#   ./mkindex           write index.html
#   ./mkindex --check   write nothing; fail if index.html would change
#
# the repo, read as a library
#   README.md           ## shelf, ### row, - book     → shelves
#   ramanujan.md        # shelf, ## row, - book       → one more shelf
#   suggested/*.md      ## stage, 1. entry, ## Notes  → a shelf's path
#   tree/*.txt          tree's drawing                → a shelf's files
#   misc.md, tips/*.md  prose                         → notes, markdown made
#                                                       html, a line a line
#
# the library index.html.in reads
#   shelves  [{name, rows: [{name, books}], path, files}]
#   book     {title, by, note, links: [[label, url]]}
#   path     {stages: [{name, entries: [book + group]}], notes} | null
#   files    node | null   node {name, kids?: [node]} — a folder has kids
#   notes    [{name, html}]

import json
import re
import sys
from pathlib import Path

import markdown

REPO = Path(__file__).resolve().parent
TEMPLATE = REPO / 'index.html.in'
OUT = REPO / 'index.html'

PATHS = {
    'Mathematics': 'suggested/math.md',
    'Computer Science': 'suggested/cs.md',
}
FILES = {
    'Mathematics': 'tree/math.txt',
    'Physics': 'tree/physics.txt',
    'Computer Science': 'tree/cs.txt',
}

LINK = re.compile(r'\[([^\]]+)\]\(([^)]+)\)')
BOLD = re.compile(r'\*\*(.+?)\*\*')
ITALIC = re.compile(r'\*([^*]+)\*')
ITEM = re.compile(r'(?:\d+\.|-) (.+)')
GROUP = re.compile(r'\*\*[^*]+\*\*|\w+:')
TABLE_HEAD = re.compile(r'^\|.*\|\n\|[-| ]+\|\n', re.MULTILINE)
TABLE_ROW = re.compile(r'^\| (\w+) +\| (.+?) +\|$', re.MULTILINE)
BRANCH = re.compile(r'([│\s]*)[├└]── (.+)')
LIBRARY = re.compile(
    r'(<script type="application/json" id="library">).*?(</script>)', re.DOTALL
)
DOCTYPE = '<!doctype html>\n'
STAMP = '<!-- generated by mkindex from index.html.in — do not edit -->\n'


def plain(text):
    # the page shows text, not markdown: *a title* loses its stars
    return ITALIC.sub(r'\1', text).strip()


def book(item):
    """**title** — by — note [label](url) …, or [title](url), or
    title — by"""
    bold = BOLD.search(item)
    head, rest = (
        (bold[1], item[bold.end() :]) if bold else item.partition(' — ')[::2]
    )
    by, *note = [
        p.strip() for p in LINK.sub('', rest).split(' — ') if p.strip()
    ] or ['']
    return {
        'title': plain(LINK.sub(r'\1', head)),
        'by': plain(by),
        'note': plain(' — '.join(note)),
        'links': LINK.findall(item),
    }


def shelves(md, depth):
    """a heading of depth #s a shelf, one deeper a row on it, - a book. books
    before the first row sit on a row of no name. a --- ends the list"""
    shelf, row = '#' * depth + ' ', '#' * (depth + 1) + ' '
    out = []
    for line in md.split('\n---')[0].splitlines():
        if line.startswith(shelf):
            name = re.sub(r'^\W+', '', line.removeprefix(shelf))
            out.append(
                {
                    'name': name,
                    'rows': [{'name': '', 'books': []}],
                    'path': None,
                    'files': None,
                }
            )
        elif line.startswith(row) and out:
            out[-1]['rows'].append(
                {'name': line.removeprefix(row).strip(), 'books': []}
            )
        elif line.startswith('- ') and out:
            out[-1]['rows'][-1]['books'].append(book(line[2:]))
    for s in out:
        s['rows'] = [r for r in s['rows'] if r['books']]
    return [s for s in out if s['rows']]


def path(md, books):
    """## a stage, an item an entry. a bold line, a `talks:` or a table row's
    first cell heads a group. an entry is what the path says of a book, the
    shelved book of its title filling what it leaves blank. ## Notes holds
    notes, not a stage"""
    # two books can share a title; the first shelved wins
    known = {b['title'].lower(): b for b in reversed(books)}
    stages, notes = [], []
    for section in re.split(r'^## ', md, flags=re.MULTILINE)[1:]:
        name, _, body = section.partition('\n')
        body = TABLE_ROW.sub(r'\1:\n- \2', TABLE_HEAD.sub('', body))
        items, group = [], ''
        for line in map(str.strip, body.splitlines()):
            if GROUP.fullmatch(line):
                group = line.strip('*:')
            elif item := ITEM.fullmatch(line):
                items.append((group, item[1]))
        if name.strip() == 'Notes':
            notes = [plain(text) for _, text in items]
        elif items:
            entries = []
            for group, text in items:
                said = book(text)
                shelf = known.get(said['title'].lower(), {})
                entries.append(
                    {k: v or shelf.get(k, v) for k, v in said.items()}
                    | {'group': group}
                )
            stages.append({'name': name.strip(), 'entries': entries})
    return {'stages': stages, 'notes': notes}


def tree(drawing):
    """tree's drawing: its first line the root, four columns a level; a name
    is a folder when the name after it sits deeper"""
    top, *lines = drawing.splitlines()
    root = {'name': top, 'kids': []}
    stack = [root]
    branches = [
        (len(m[1]) // 4, m[2]) for m in map(BRANCH.fullmatch, lines) if m
    ]
    for (depth, name), (after, _) in zip(
        branches, branches[1:] + [(0, '')], strict=True
    ):
        del stack[depth + 1 :]
        node = {'name': name}
        stack[-1]['kids'].append(node)
        if after > depth:
            node['kids'] = []
            stack.append(node)
    return root


def render(library):
    # </ would close the script the library sits in
    data = json.dumps(library, ensure_ascii=False).replace('</', '<\\/')
    src = TEMPLATE.read_text()
    assert src.startswith(DOCTYPE), (
        f'{TEMPLATE.name}: no {DOCTYPE!r} to stamp under'
    )
    src, found = LIBRARY.subn(lambda m: m[1] + data + m[2], src)
    assert found == 1, (
        f'{TEMPLATE.name}: library script found {found}×, want 1'
    )
    return DOCTYPE + STAMP + src.removeprefix(DOCTYPE)


def check_tables(shelves):
    """a shelf is matched to its path and its files by name, so a renamed shelf
    or a new .md or tree would be dropped without a word: say it"""
    names = {s['name'] for s in shelves}
    lost = {*PATHS, *FILES} - names
    assert not lost, (
        f'no shelf named {sorted(lost)}: PATHS and FILES go by shelf name'
    )
    for glob, table in (('suggested/*.md', PATHS), ('tree/*.txt', FILES)):
        loose = {str(f.relative_to(REPO)) for f in REPO.glob(glob)} - set(
            table.values()
        )
        name = 'PATHS' if table is PATHS else 'FILES'
        assert not loose, f'{sorted(loose)} belongs to no shelf: add to {name}'


def main():
    library = {
        'shelves': shelves((REPO / 'README.md').read_text(), 2)
        + shelves((REPO / 'ramanujan.md').read_text(), 1),
        'notes': [
            {
                'name': str(t.relative_to(REPO)),
                'html': markdown.markdown(t.read_text(), extensions=['nl2br']),
            }
            for t in [REPO / 'misc.md', *sorted((REPO / 'tips').glob('*.md'))]
        ],
    }
    books = [
        b for s in library['shelves'] for r in s['rows'] for b in r['books']
    ]
    for shelf in library['shelves']:
        if md := PATHS.get(shelf['name']):
            shelf['path'] = path((REPO / md).read_text(), books)
        if txt := FILES.get(shelf['name']):
            shelf['files'] = tree((REPO / txt).read_text())
    check_tables(library['shelves'])

    html = render(library)
    if sys.argv[1:] == ['--check']:
        sys.exit(
            0
            if OUT.read_text() == html
            else f'{OUT.name} is stale: run ./{Path(__file__).name}'
        )
    OUT.write_text(html)
    entries = sum(
        len(st['entries'])
        for s in library['shelves']
        if s['path']
        for st in s['path']['stages']
    )
    trees = sum(1 for s in library['shelves'] if s['files'])
    print(
        f'{len(library["shelves"])} shelves, {len(books)} books, '
        f'{entries} path entries, {trees} file trees, '
        f'{len(library["notes"])} notes → {OUT.name}'
    )


if __name__ == '__main__':
    main()
