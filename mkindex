#!/usr/bin/env python

# mkindex — writes index.html, the repo as a bookshelf: index.html.in with
# its library filled from the .md files. rerun after they change, commit both.
#
#   ./mkindex && git diff --exit-code index.html   # clean: index.html is current
#
# the repo, read as a disk
#   README.md, ramanujan.md  ## shelf, ### row, - book  → folders of books
#   suggested/{math,cs}.md   ## stage, 1. entry         → a shelf's path
#   tree/*.txt               tree's drawing             → shelf/, the real files
#   misc.md, tips/*.md       prose                      → pages, as written
#
# the library index.html.in reads
#   root   the top folder
#   disk   {folder: [name | name/]}
#   paths  {folder: [{name, entries: [{name, note, file}]}]}
#   pages  {path: {title, by, note, links} | {title, text}}

import json
import posixpath
import re
from pathlib import Path

REPO = Path(__file__).resolve().parent
TEMPLATE = REPO / 'index.html.in'
OUT = REPO / 'index.html'

ROOT = 'resources'
PATHS = {'Mathematics': 'suggested/math.md', 'Computer Science': 'suggested/cs.md'}

LINK = re.compile(r'\[([^\]]+)\]\(([^)]+)\)')
BOLD = re.compile(r'\*\*(.+?)\*\*')
ITEM = re.compile(r'(?:\d+\.|-) (.+)')
GROUP = re.compile(r'\*\*[^*]+\*\*|\w+:')
TABLE_HEAD = re.compile(r'^\|.*\|\n\|[-| ]+\|\n', re.M)
TABLE_ROW = re.compile(r'^\| (\w+) +\| (.+?) +\|$', re.M)
BRANCH = re.compile(r'([│\s]*)[├└]── (.+)')
LIBRARY = re.compile(r'(<script type="application/json" id="library">).*?(</script>)', re.S)
DOCTYPE = '<!doctype html>\n'
STAMP = '<!-- generated by mkindex from index.html.in — do not edit -->\n'


def book(item):
    """**title** — by — note [label](url) …, or [title](url), or title — by"""
    bold = BOLD.search(item)
    head, rest = (bold[1], item[bold.end() :]) if bold else item.partition(' — ')[::2]
    by, *note = [p.strip() for p in LINK.sub('', rest).split(' — ') if p.strip()] or ['']
    return {
        'title': LINK.sub(r'\1', head).strip(),
        'by': by,
        'note': ' — '.join(note),
        'links': LINK.findall(item),
    }


def filename(text):
    # a name cannot hold the separator; the division slash reads the same
    return text.replace('/', '∕')


class Library:
    """the made-up disk the page browses: folders, the paths through them, and
    the page each book or text file shows"""

    def __init__(self, root):
        self.root = root
        self.disk = {root: []}
        self.paths = {}
        self.pages = {}

    def shelves(self, md, top):
        """## a shelf, ### a row on it, - a book. a --- ends the list"""
        shelf = row = None
        for line in md.split('\n---')[0].splitlines():
            if line.startswith('## '):
                shelf = row = self.mkdir(top, re.sub(r'^\W+', '', line[3:]))
            elif line.startswith('### ') and shelf:
                row = self.mkdir(shelf, line[4:].strip())
            elif line.startswith('- ') and row:
                b = book(line[2:])
                self.file(row, filename(b['title'] + (f' — {b["by"]}' if b['by'] else '')), b)

    def path(self, md, folder):
        """## a stage, an item an entry. a bold line, a `talks:` or a table
        row's first cell heads a group. an entry opens the shelf's book of
        its title, or a page of its own — so read the shelves first"""
        titles = {}
        for to, page in self.pages.items():
            titles.setdefault(page['title'].lower(), to)
        stages = []
        for section in re.split(r'^## ', md, flags=re.M)[1:]:
            name, _, body = section.partition('\n')
            body = TABLE_ROW.sub(r'\1:\n- \2', TABLE_HEAD.sub('', body))
            entries, group = [], ''
            for line in map(str.strip, body.splitlines()):
                if GROUP.fullmatch(line):
                    group = line.strip('*:')
                elif item := ITEM.fullmatch(line):
                    b = book(item[1])
                    to = titles.get(b['title'].lower()) or self.page(f'{folder}/·/{filename(b["title"])}', b)
                    entries.append(
                        {
                            'name': b['title'],
                            'note': ' · '.join(x for x in (group, b['by'], b['note']) if x),
                            'file': posixpath.relpath(to, folder),
                        }
                    )
            if entries:
                stages.append({'name': name.strip(), 'entries': entries})
        self.paths[folder] = stages

    def tree(self, drawing, top):
        """tree's drawing: four columns a level; a name is a folder when the
        name after it sits deeper"""
        branches = [(len(m[1]) // 4, m[2]) for m in map(BRANCH.fullmatch, drawing.splitlines()) if m]
        stack = [top]
        for (depth, name), (after, _) in zip(branches, branches[1:] + [(0, '')], strict=True):
            del stack[depth + 1 :]
            if after > depth:
                stack.append(self.mkdir(stack[-1], name))
            else:
                self.file(stack[-1], name)

    def prose(self, file, folder):
        self.file(folder, file.name, {'title': file.name, 'text': file.read_text()})

    def mkdir(self, parent, name):
        folder = f'{parent}/{name}'
        if folder not in self.disk:
            self.disk[folder] = []
            self.disk[parent].append(name + '/')
        return folder

    def file(self, folder, name, page=None):
        # two books can share a title and author, two names in a folder cannot
        while name in self.disk[folder]:
            name += ' ·'
        self.disk[folder].append(name)
        if page:
            self.page(f'{folder}/{name}', page)

    def page(self, to, page):
        self.pages[to] = page
        return to


def render(library):
    # </ would close the script the library sits in
    data = json.dumps(vars(library), ensure_ascii=False).replace('</', '<\\/')
    src = TEMPLATE.read_text()
    assert src.startswith(DOCTYPE), f'{TEMPLATE.name}: no {DOCTYPE!r} to stamp under'
    src, found = LIBRARY.subn(lambda m: m[1] + data + m[2], src)
    assert found == 1, f'{TEMPLATE.name}: library script found {found}×, want 1'
    return DOCTYPE + STAMP + src.removeprefix(DOCTYPE)


def main():
    library = Library(ROOT)
    library.shelves((REPO / 'README.md').read_text(), ROOT)
    library.shelves((REPO / 'ramanujan.md').read_text(), library.mkdir(ROOT, 'Ramanujan'))
    for shelf, md in PATHS.items():
        library.path((REPO / md).read_text(), f'{ROOT}/{shelf}')
    shelf = library.mkdir(ROOT, 'shelf')
    for drawing in sorted((REPO / 'tree').glob('*.txt')):
        library.tree(drawing.read_text(), library.mkdir(shelf, drawing.stem))
    library.prose(REPO / 'misc.md', ROOT)
    tips = library.mkdir(ROOT, 'tips')
    for tip in sorted((REPO / 'tips').glob('*.md')):
        library.prose(tip, tips)

    OUT.write_text(render(library))
    entries = sum(len(stage['entries']) for stages in library.paths.values() for stage in stages)
    print(f'{len(library.disk)} folders, {len(library.pages)} pages, {entries} path entries → {OUT.name}')


if __name__ == '__main__':
    main()
